---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const ogImage = Astro.site ? new URL('/icon-512.png', Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
      );
      els.forEach((el) => io.observe(el));

      // Anything already on screen at load animates in straight away rather than waiting for the scroll
      // threshold. Checked again once fonts and the page have loaded, since the hero shrinks a little when
      // the web fonts swap in. Reading every rect first also flushes styles, so the transition still plays.
      const revealOnScreen = () => {
        const hidden = [...document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)')];
        const onScreen = hidden.map((el) => {
          const offset = new DOMMatrixReadOnly(getComputedStyle(el).transform).m42;
          return el.getBoundingClientRect().top - offset < window.innerHeight;
        });
        hidden.forEach((el, i) => {
          if (!onScreen[i]) return;
          el.classList.add('is-visible');
          io.unobserve(el);
        });
      };
      revealOnScreen();
      document.fonts.ready.then(revealOnScreen);
      window.addEventListener('load', revealOnScreen, { once: true });
    </script>
  </body>
</html>
