---
const nos = ['No account', 'No server', 'No analytics', 'No ads'];
---

<section class="px-3 pt-3 sm:px-4 sm:pt-4">
  <div class="reveal grid items-center gap-12 rounded-card bg-blue-tint px-8 py-16 sm:px-14 sm:py-20 lg:grid-cols-[1.2fr_1fr] lg:gap-16 lg:px-20">
    <div>
      <p class="eyebrow text-ios-blue">Privacy</p>
      <h2 class="display mt-5 text-[clamp(2.4rem,5vw,4rem)]">Your food is your business.</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/60">
        Macro doesn't have a server, so there's nowhere for your data to go. Your meals live on your iPhone, and in
        your own private iCloud if you sync. We couldn't see them if we wanted to.
      </p>
      <a
        href="/privacy-policy"
        class="mt-8 inline-flex items-center gap-1.5 text-[17px] font-medium text-ios-blue hover:underline"
      >
        Read the privacy policy
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <ul class="grid gap-2.5">
      {
        nos.map((item) => (
          <li class="flex items-center gap-4 rounded-2xl bg-white/70 px-5 py-4 text-lg font-medium">
            <span class="grid size-7 place-items-center rounded-full bg-ios-blue text-white">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 6.2l2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
