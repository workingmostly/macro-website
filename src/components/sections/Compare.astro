---
import CompareDemo from '../CompareDemo';
---

<section class="px-3 pt-28 sm:px-4 sm:pt-40" aria-labelledby="compare-title">
  <div class="reveal mx-auto max-w-4xl px-3 text-center">
    <p class="eyebrow text-ios-blue">Side by side</p>
    <h2 id="compare-title" class="display mt-5 text-[clamp(2.6rem,6.4vw,4.75rem)]">
      A typical tracker <span class="text-faint">vs.</span> Macro.
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-balance text-muted sm:text-xl">
      A homemade spag bol for four, logged step by step in each.
    </p>
  </div>

  <!-- Hydrates a little before it scrolls into view, so it can rewind from the end state without a visible jump. -->
  <div class="reveal mt-14 sm:mt-20">
    <CompareDemo client:visible={{ rootMargin: '400px' }} />
  </div>
</section>
