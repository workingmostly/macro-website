---
const typical = [
  'Tap “Add food”',
  'Search “chicken breast”',
  'Scroll past dozens of near-identical entries',
  'Guess which one is closest',
  'Change the unit to grams',
  'Weigh it and type 180',
  'Search “basmati rice”',
  'Wonder whether that’s cooked or dry weight',
  'Search “broccoli”',
  'Pick a serving size',
  'Save the meal',
];

const macro = [
  { text: 'Drag to', value: '650 kcal', color: 'bg-ios-green' },
  { text: 'Tap' },
  { text: 'Drag to', value: '55 g protein', color: 'bg-ios-blue' },
  { text: 'Tap' },
];
---

<section class="px-3 pt-28 sm:px-4 sm:pt-40">
  <div class="reveal mx-auto max-w-4xl px-3 text-center">
    <p class="eyebrow text-ios-blue">What makes Macro different</p>
    <h2 class="display mt-5 text-[clamp(2.6rem,6.4vw,4.75rem)]">
      Other trackers want a spreadsheet. You need a ballpark.
    </h2>
  </div>

  <div class="mt-14 grid gap-3 sm:mt-20 sm:gap-4 lg:grid-cols-2">
    <div class="reveal rounded-card bg-surface p-8 sm:p-14">
      <p class="eyebrow text-faint">A typical tracker</p>
      <h3 class="mt-3 font-display text-3xl font-semibold tracking-[-0.03em]">Chicken, rice and broccoli</h3>
      <ol class="mt-9 space-y-3.5">
        {
          typical.map((step, i) => (
            <li class="flex items-baseline gap-4 text-[17px] text-ink/45">
              <span class="w-5 shrink-0 text-right text-sm tabular-nums text-ink/25">{i + 1}</span>
              {step}
            </li>
          ))
        }
      </ol>
      <p class="mt-9 text-[17px] text-muted">…and again at dinner. And tomorrow.</p>
    </div>

    <div class="reveal flex flex-col rounded-card bg-night p-8 text-white sm:p-14">
      <p class="eyebrow text-white/40">Macro</p>
      <h3 class="mt-3 font-display text-3xl font-semibold tracking-[-0.03em]">Chicken, rice and broccoli</h3>
      <ol class="mt-9 space-y-5">
        {
          macro.map((step, i) => (
            <li class="flex items-center gap-4 text-xl sm:text-2xl">
              <span class="w-5 shrink-0 text-right text-sm tabular-nums text-white/30">{i + 1}</span>
              <span class="text-white/90">{step.text}</span>
              {step.value && (
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 py-1 pr-3.5 pl-2.5 text-lg font-medium sm:text-xl">
                  <span class={`size-2.5 rounded-full ${step.color}`} />
                  {step.value}
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <p class="display mt-auto pt-16 text-[clamp(4rem,9vw,7rem)]">Done.</p>
      <p class="mt-3 max-w-md text-[17px] leading-relaxed text-white/55">
        Close enough to keep you honest, quick enough that you'll still be doing it in six months.
      </p>
    </div>
  </div>
</section>
