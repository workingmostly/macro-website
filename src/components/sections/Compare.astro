---
/*
  One homemade spag bol, logged two ways.
  The difference in height is the argument: a long column of form-filling next to a
  short, calm card. Keep the cards at their natural heights rather than evening them up.
*/

type Part = string | { search: string } | { field: string } | { pick: string };

const typical: Part[][] = [
  ['Tap “Create recipe”'],
  ['Search', { search: 'beef mince' }],
  ['Scroll past dozens of lookalikes'],
  ['Type the pack weight', { field: '500 g' }],
  ['Search', { search: 'onion' }],
  ['Guess its size', { pick: 'Medium' }],
  ['Search', { search: 'chopped tomatoes' }],
  ['Can’t find your brand. Pick another.'],
  ['Search', { search: 'spaghetti' }],
  ['Work out: dry weight or cooked?'],
  ['Weigh it and type', { field: '300 g' }],
  ['Turn “a glug” of olive oil into grams'],
  ['Set servings to', { pick: '4' }],
  ['Log one serving. Yours was bigger.'],
];

// Tomorrow's breakfast, starting again from the top. Decorative: it fades out under the tally.
const again: Part[][] = [
  ['Tap “Add food”'],
  ['Search', { search: 'porridge oats' }],
  ['Scroll past dozens of lookalikes'],
  ['Weigh it and type', { field: '40 g' }],
];

// Each Macro step is a drag and a tap, the way each step above bundles a few taps of its own.
// A bit over a quarter of the pot, since yours was bigger. 700 kcal is still in the green band of the
// app's calorie colour scale.
const macro = [
  { value: '700', unit: 'kcal', color: 'text-ios-green', bar: 'bg-ios-green' },
  { value: '40', unit: 'g protein', color: 'text-ios-blue', bar: 'bg-ios-blue' },
];

const token =
  'inline-flex items-center gap-1.5 rounded-lg bg-white px-2 py-0.5 whitespace-nowrap text-ink ring-1 ring-black/[0.06]';
const row = 'flex items-baseline gap-3.5 py-2.5 text-[15px] leading-snug sm:text-base md:text-[15px] lg:text-base';
---

<section class="px-3 pt-28 sm:px-4 sm:pt-40" aria-labelledby="compare-title">
  <div class="reveal mx-auto max-w-4xl px-3 text-center">
    <p class="eyebrow text-ios-blue">Side by side</p>
    <h2 id="compare-title" class="display mt-5 text-[clamp(2.6rem,6.4vw,4.75rem)]">Same dinner. None of the admin.</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-balance text-muted sm:text-xl">
      One homemade spag bol for four, logged the usual way and then in Macro.
    </p>
  </div>

  <div class="mt-14 grid items-start gap-3 sm:mt-20 sm:gap-4 md:grid-cols-2">
    <!-- The usual way: long, small, and it never really ends. -->
    <article
      class="reveal overflow-hidden rounded-card bg-surface px-7 pt-7 sm:px-12 sm:pt-12 md:px-9 md:pt-10 lg:px-12 lg:pt-12"
      aria-labelledby="compare-typical"
    >
      <div class="flex items-baseline justify-between gap-4">
        <h3 id="compare-typical" class="eyebrow text-muted">A typical tracker</h3>
        <p class="font-display text-lg font-semibold tracking-[-0.02em] text-ink/70 tabular-nums">
          {typical.length} steps
        </p>
      </div>
      <div aria-hidden="true" class="mt-5 flex gap-1">
        {typical.map(() => <span class="h-[3px] flex-1 rounded-full bg-ink/20" />)}
      </div>

      {
        [typical, again].map((steps, l) => (
          <Fragment>
            {l === 1 && (
              <p class="mt-9 font-display text-2xl leading-tight font-semibold tracking-[-0.03em] sm:text-[1.75rem] md:text-2xl lg:text-[1.75rem]">
                <span class="block">That’s one meal.</span>
                <span class="block text-muted">About twenty more this week.</span>
              </p>
            )}
            <ol
              role={l === 0 ? 'list' : undefined}
              aria-hidden={l === 1 ? 'true' : undefined}
              class:list={[
                l === 0
                  ? 'mt-5 divide-y divide-ink/[0.07] border-b border-ink/[0.07]'
                  : 'mt-5 h-28 divide-y divide-ink/[0.07] overflow-hidden select-none [mask-image:linear-gradient(to_bottom,black_5%,transparent_92%)] sm:h-32',
              ]}
            >
              {steps.map((parts, i) => (
                <li class={`${row} text-ink/70`}>
                  <span aria-hidden="true" class="w-5 shrink-0 text-right text-xs text-muted tabular-nums">
                    {i + 1}
                  </span>
                  <span>
                    {parts.map((part, j) => (
                      <Fragment>
                        {j > 0 && ' '}
                        {typeof part === 'string' ? (
                          part
                        ) : 'search' in part ? (
                          <span class={token}>
                            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="text-ink/40">
                              <circle cx="5" cy="5" r="3.75" stroke="currentColor" stroke-width="1.6" />
                              <path d="M8 8l2.75 2.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>
                            {part.search}
                          </span>
                        ) : 'field' in part ? (
                          <span class={`${token} tabular-nums`}>{part.field}</span>
                        ) : (
                          <span class={token}>
                            {part.pick}
                            <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" class="text-ink/40">
                              <path
                                d="M2 3.75l3 3 3-3"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </span>
                        )}
                      </Fragment>
                    ))}
                  </span>
                </li>
              ))}
            </ol>
          </Fragment>
        ))
      }
    </article>

    <!-- Macro: short, calm and finished. Rides alongside the long list on wider screens. -->
    <article
      class="reveal relative overflow-hidden rounded-card bg-night p-7 text-white sm:p-12 md:top-24 md:px-9 md:py-10 lg:p-12 md:[@media(min-height:48rem)]:sticky"
      style="transition-delay:90ms"
      aria-labelledby="compare-macro"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-[radial-gradient(70%_70%_at_20%_100%,rgb(255_149_0/0.09),transparent)]"
      >
      </div>

      <div class="relative">
        <div class="flex items-baseline justify-between gap-4">
          <h3 id="compare-macro" class="eyebrow text-white/60">Macro</h3>
          <p class="font-display text-lg font-semibold tracking-[-0.02em] tabular-nums">{macro.length} steps</p>
        </div>
        <div aria-hidden="true" class="mt-5 flex gap-1">
          {macro.map((step) => <span class={`h-[3px] flex-1 rounded-full ${step.bar}`} />)}
        </div>

        <ol role="list" class="mt-5 divide-y divide-white/10 border-b border-white/10">
          {
            macro.map((step, i) => (
              <li class="flex items-baseline gap-3.5 py-5 sm:py-6">
                <span aria-hidden="true" class="w-5 shrink-0 text-right text-xs text-white/50 tabular-nums">
                  {i + 1}
                </span>
                <p class="min-w-0 flex-1 text-[17px] text-white/60">
                  <span class="block">Drag to</span>
                  <span class="mt-1 block">
                    <span class="whitespace-nowrap">
                      <span
                        class={`-ml-[0.05em] font-display text-[clamp(4rem,9vw,6.5rem)] leading-[0.9] font-extralight tracking-[-0.05em] tabular-nums ${step.color}`}
                      >
                        {step.value}
                      </span>{' '}
                      <span class="text-xl text-white/80">{step.unit}</span>
                    </span>
                    <span>, then tap</span>
                  </span>
                </p>
              </li>
            ))
          }
        </ol>

        <p class="display mt-10 text-[clamp(3rem,6vw,4.5rem)] sm:mt-12">Still hot.</p>
        <p class="mt-4 text-[17px] leading-relaxed text-white/60">Then get on with your evening.</p>
      </div>
    </article>
  </div>
</section>
