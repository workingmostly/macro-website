---
import { Phone, TodayScreen, SAMPLE_DAY } from '../screens/ios';
import { site } from '../../config';
---

<section class="px-3 sm:px-4">
  <div class="grid gap-3 sm:gap-4 lg:grid-cols-2">
    <div
      class="reveal flex flex-col items-center justify-center rounded-card bg-surface px-7 py-20 text-center sm:px-16 sm:py-28"
    >
      <h2 class="display text-[clamp(2.4rem,4.8vw,4rem)]">Two numbers.<br />We do the rest.</h2>
      <p class="mt-6 max-w-[30rem] text-lg leading-relaxed text-muted">
        Most trackers want you to search, weigh and pick a serving size for every ingredient. Macro asks for two
        things you already roughly know: how many calories, and how much protein. Carbs and fat are worked out for
        you.
      </p>
      <a href={site.betaUrl} target="_blank" rel="noopener" class="btn btn-primary mt-10 h-14 px-8 text-[17px]">{site.ctaLabel}</a>
    </div>

    <div
      class="reveal relative flex h-[560px] justify-center overflow-hidden rounded-card bg-green-tint pt-16 sm:h-[640px] lg:h-[680px]"
    >
      <div
        aria-hidden="true"
        class="absolute inset-x-0 bottom-0 h-1/2 bg-[radial-gradient(60%_80%_at_50%_100%,rgb(52_199_89/0.25),transparent)]"
      >
      </div>
      <Phone className="relative [--s:0.72] sm:[--s:0.8]" label="Macro's Today screen showing four meals">
        <TodayScreen meals={SAMPLE_DAY} />
      </Phone>
    </div>
  </div>
</section>
