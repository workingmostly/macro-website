---
interface Props {
  /** For linking straight to a card, as the hero's voice pill does. */
  id?: string;
  title: string;
  body: string;
  class?: string;
  /** Two columns wide from md up, text beside the picture. */
  wide?: boolean;
  /** The whole row: two columns on md, three on lg. */
  full?: boolean;
  /** A small label above the title, such as "New". */
  badge?: string;
  /** A quieter line under the body, for small print. */
  note?: string;
}

const { id, title, body, class: className = 'bg-surface', wide = false, full = false, badge, note } = Astro.props;
---

{
  wide || full ? (
    <article
      id={id}
      class:list={[
        'reveal grid overflow-hidden rounded-card md:col-span-2 md:grid-cols-2',
        full && 'lg:col-span-3',
        className,
      ]}
    >
      <div class="flex flex-col justify-end p-8 pb-4 sm:p-11 md:pb-11">
        {
          badge && (
            <p class="mb-4 self-start rounded-full bg-ios-purple/12 px-2.5 py-1 text-[13px] font-semibold text-[#8a3dba]">
              {badge}
            </p>
          )
        }
        <h3 class="font-display text-[1.75rem] leading-tight font-semibold tracking-[-0.035em] sm:text-[2rem]">{title}</h3>
        <p class="mt-3 max-w-md text-[17px] leading-relaxed text-muted">{body}</p>
        {note && <p class="mt-4 max-w-md text-sm text-muted">{note}</p>}
      </div>
      <div class="flex items-center justify-center p-6 pb-9 sm:p-10">
        <slot />
      </div>
    </article>
  ) : (
    <article id={id} class:list={['reveal flex flex-col overflow-hidden rounded-card', className]}>
      <div class="flex h-[230px] items-center justify-center px-6 pt-6">
        <slot />
      </div>
      <div class="px-8 pt-4 pb-10 sm:px-10">
        <h3 class="font-display text-[1.5rem] leading-tight font-semibold tracking-[-0.03em]">{title}</h3>
        <p class="mt-2.5 text-base leading-relaxed text-muted">{body}</p>
        {note && <p class="mt-3 text-sm text-muted">{note}</p>}
      </div>
    </article>
  )
}
