---
interface Props {
  title: string;
  body: string;
  class?: string;
  wide?: boolean;
}

const { title, body, class: className = 'bg-surface', wide = false } = Astro.props;
---

{
  wide ? (
    <article class:list={['reveal grid overflow-hidden rounded-card md:col-span-2 md:grid-cols-2', className]}>
      <div class="flex flex-col justify-end p-8 pb-4 sm:p-11 md:pb-11">
        <h3 class="font-display text-[1.75rem] leading-tight font-semibold tracking-[-0.035em] sm:text-[2rem]">{title}</h3>
        <p class="mt-3 max-w-md text-[17px] leading-relaxed text-muted">{body}</p>
      </div>
      <div class="flex items-center justify-center p-6 pb-9 sm:p-10">
        <slot />
      </div>
    </article>
  ) : (
    <article class:list={['reveal flex flex-col overflow-hidden rounded-card', className]}>
      <div class="flex h-[230px] items-center justify-center px-6 pt-6">
        <slot />
      </div>
      <div class="px-8 pt-4 pb-10 sm:px-10">
        <h3 class="font-display text-[1.5rem] leading-tight font-semibold tracking-[-0.03em]">{title}</h3>
        <p class="mt-2.5 text-base leading-relaxed text-muted">{body}</p>
      </div>
    </article>
  )
}
