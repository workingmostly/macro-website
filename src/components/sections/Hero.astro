---
import HeroDemo from '../HeroDemo';
import { site } from '../../config';
---

<section class="px-3 pt-22 sm:px-4 sm:pt-4">
  <div class="relative overflow-hidden rounded-card bg-surface">
    <div
      class="mx-auto grid max-w-6xl items-center gap-14 px-6 pt-12 pb-14 sm:px-10 sm:pt-32 lg:grid-cols-[1.2fr_1fr] lg:gap-4 lg:pt-36 lg:pb-16"
    >
      <div class="text-center lg:text-left">
        <!-- The newest thing, kept small and above the headline so the two drags stay the main story. Jumps to its
             card in Features. -->
        <a
          href="#voice"
          class="mb-6 inline-flex items-center gap-2 rounded-full bg-white py-1 pr-3 pl-1 text-[14px] font-medium text-ink/75 shadow-[0_1px_2px_rgb(0_0_0/0.06)] ring-1 ring-black/5 transition-colors hover:text-ink focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-ios-blue/45 sm:mb-7"
        >
          <span class="inline-flex items-center gap-1 rounded-full bg-ios-blue py-1 pr-2.5 pl-2 text-[12px] font-semibold text-white">
            <svg width="11" height="11" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="6.6" y="1.2" width="6.8" height="11" rx="3.4" fill="currentColor"></rect>
              <path d="M3.9 9.2a6.1 6.1 0 0012.2 0M10 15.4v3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
            </svg>
            New
          </span>
          Or just say what you ate
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <h1 class="display text-[clamp(2.9rem,6.6vw,5.25rem)]">
          Food tracking, without the fixation.
        </h1>

        <p class="mx-auto mt-6 max-w-[34rem] text-lg leading-relaxed text-muted sm:text-xl lg:mx-0">
          Macro is the fastest way to track your food. No barcodes, no searching, no photos. Just two drags and
          you're done.
        </p>

        <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
          <a href={site.betaUrl} target="_blank" rel="noopener" data-cta class="btn btn-primary h-14 px-8 text-[17px]">
            {site.ctaLabel}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <span class="text-sm text-muted">{site.availability}</span>
        </div>
      </div>

      <HeroDemo client:load />
    </div>
  </div>
</section>
