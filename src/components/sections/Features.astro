---
import FeatureCard from './FeatureCard.astro';
import { StatsCard, SAMPLE_DAY } from '../screens/ios';
import { AdherenceCard } from '../screens/Adherence';

const day = SAMPLE_DAY.reduce((t, m) => ({ calories: t.calories + m.calories, protein: t.protein + m.protein }), {
  calories: 0,
  protein: 0,
});

const toggles = [
  { label: 'Calories', on: true },
  { label: 'Macros', on: true },
  { label: 'Fibre', on: false },
  { label: 'Food emojis', on: true },
];
---

<section id="features" class="px-3 pt-28 sm:px-4 sm:pt-40">
  <div class="reveal mx-auto max-w-3xl px-3 text-center">
    <p class="eyebrow text-ios-purple">Features</p>
    <h2 class="display mt-5 text-[clamp(2.6rem,6.4vw,4.75rem)]">Small app. Thoughtful details.</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">
      Macro is designed from the ground up to make logging less hassle.
    </p>
  </div>

  <div class="mt-14 grid gap-3 sm:mt-20 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
    <FeatureCard
      wide
      title="Carbs and fat, worked out for you."
      body="Protein is set aside, and the calories left over are split between carbs and fat: 60/40 by default, adjustable to suit how you eat. Rather enter one yourself? Switch to manual and the other is still calculated exactly."
    >
      <div class="w-full max-w-[380px]">
        <div class="ios-scope rounded-[24px] shadow-[0_24px_60px_-28px_rgb(0_0_0/0.35)]">
          <StatsCard calories={day.calories} protein={day.protein} expanded />
        </div>
        <p class="mt-5 text-center font-mono text-[13px] text-ink/45">kcal = 4 × protein + 4 × carbs + 9 × fat</p>
      </div>
    </FeatureCard>

    <FeatureCard
      title="Action Button ready."
      body="Add Meal works with Shortcuts, so you can put it on the Action Button and go from pocket to logging in one press. Or just ask Siri to log a meal in Macro."
    >
      <div class="flex items-center gap-4">
        <div
          class="relative size-[124px] shrink-0 rounded-[28px] bg-linear-to-br from-[#4aa3ff] to-[#0062e0] p-4 text-white shadow-[0_20px_40px_-18px_rgb(0_98_224/0.8)]"
        >
          <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
            <circle cx="13" cy="13" r="12" fill="rgb(255 255 255 / 0.22)"></circle>
            <path d="M13 7.5v11M7.5 13h11" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
          </svg>
          <p class="absolute bottom-3.5 left-4 text-[15px] font-semibold">Add Meal</p>
        </div>
        <div
          class="ios-scope max-w-[150px] rounded-[20px] rounded-bl-[6px] bg-white px-4 py-3 text-[15px] leading-snug shadow-[0_10px_30px_-12px_rgb(0_0_0/0.25)]"
        >
          “Log a meal in Macro”
        </div>
      </div>
    </FeatureCard>

    <FeatureCard
      title="Opens ready to log."
      body="Opening Macro starts a meal, so the first thing you see is the calories screen. Changed your mind? Swipe in from the edge to cancel."
    >
      <div class="flex items-center gap-5">
        <img src="/icon.png" alt="" width="72" height="72" class="size-[72px] rounded-[18px] shadow-[0_14px_30px_-12px_rgb(0_0_0/0.5)]" />
        <svg width="28" height="14" viewBox="0 0 28 14" fill="none" class="text-ink/25" aria-hidden="true">
          <path d="M1 7h24M20 2l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div
          class="ios-scope relative flex h-[160px] w-[112px] flex-col items-center justify-center overflow-hidden rounded-[22px] bg-white shadow-[0_14px_40px_-16px_rgb(0_0_0/0.3)] ring-1 ring-black/5"
        >
          <span class="text-[8px] font-semibold tracking-[0.14em] text-ios-green">CALORIES</span>
          <span class="mt-0.5 text-[56px] leading-none font-extralight">0</span>
          <span class="mt-1 text-[10px] text-muted">Kcal</span>
        </div>
      </div>
    </FeatureCard>

    <FeatureCard
      wide
      title="On track, at a glance."
      body="Macro looks at your week and gives you a straight answer. A day counts when calories land within 10% of your goal, over or under, and protein gets close or goes over. Tap the badge to see why, and what would change it."
    >
      <AdherenceCard className="w-full max-w-[380px]" />
    </FeatureCard>

    <FeatureCard
      title="Reminders that learn."
      body="Macro notices when you usually eat and nudges you around then. It won't nag about a meal you've already logged, and nothing leaves your phone."
    >
      <div class="relative w-full max-w-[320px]">
        <div class="absolute inset-x-4 -bottom-2.5 h-full rounded-[22px] bg-white/60 ring-1 ring-black/5"></div>
        <div
          class="ios-scope relative flex gap-3 rounded-[22px] bg-white p-3.5 shadow-[0_16px_40px_-16px_rgb(0_0_0/0.3)] ring-1 ring-black/5"
        >
          <img src="/icon.png" alt="" width="38" height="38" class="size-[38px] rounded-[9px]" />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between">
              <span class="text-[15px] font-semibold">Lunch?</span>
              <span class="text-[13px] text-muted">now</span>
            </div>
            <p class="text-[15px] leading-snug text-ink/80">You usually eat around 12:45.</p>
          </div>
        </div>
      </div>
    </FeatureCard>

    <FeatureCard
      title="Emoji, not ingredients."
      body="Tag a meal with a single emoji instead of typing out what it was. Macro learns what you tend to log at a given size and suggests one."
    >
      <div class="flex flex-col items-center">
        <span class="text-[64px] leading-none">🍗</span>
        <div class="mt-6 flex gap-2">
          {
            ['🍣', '🥗', '🍗', '🍕', '🥪'].map((e) => (
              <span
                class:list={[
                  'grid size-12 place-items-center rounded-[13px] text-[26px]',
                  e === '🍗' ? 'bg-[#dcdce1]' : 'bg-white',
                ]}
              >
                {e}
              </span>
            ))
          }
        </div>
      </div>
    </FeatureCard>

    <FeatureCard
      title="Late nights, right day."
      body="Choose when your day starts, so a post-midnight snack counts towards the day you were actually living."
    >
      <div class="text-center">
        <p class="font-display text-[4.25rem] leading-none font-semibold tracking-[-0.05em]">
          1:30<span class="ml-1.5 text-2xl tracking-normal text-muted">AM</span>
        </p>
        <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-[15px] shadow-[0_1px_2px_rgb(0_0_0/0.06)]">
          <span aria-hidden="true">🌙</span> Counts towards Friday
        </p>
      </div>
    </FeatureCard>

    <FeatureCard
      title="Backed up to your iCloud."
      body="Your log syncs to your own private iCloud, so it's still there when you get a new phone. No sign-up, ever."
    >
      <div class="flex flex-col items-center">
        <svg width="132" height="88" viewBox="0 0 132 88" aria-hidden="true">
          <defs>
            <linearGradient id="cloud" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#5ac8fa"></stop>
              <stop offset="1" stop-color="#007aff"></stop>
            </linearGradient>
          </defs>
          <path
            d="M34 86C16 86 3 73 3 57c0-14 10-26 24-29C32 12 46 2 63 2c18 0 33 12 37 29 16 1 29 14 29 30 0 14-11 25-26 25H34z"
            fill="url(#cloud)"></path>
          <path d="M48 47l11 11 22-22" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
        </svg>
        <p class="ios-scope mt-4 text-[15px] text-muted">Synced · just now</p>
      </div>
    </FeatureCard>

    <FeatureCard
      title="Goals in a minute."
      body="Not sure what to aim for? The built-in calculator works out calories and protein from your stats and whether you want to lose, maintain or gain."
    >
      <div class="ios-scope w-full max-w-[300px]">
        <div class="flex rounded-[10px] bg-[#e3e3e8] p-[3px] text-[14px] font-medium">
          {
            ['Lose', 'Maintain', 'Gain'].map((label) => (
              <span
                class:list={[
                  'flex-1 rounded-[8px] py-1.5 text-center',
                  label === 'Lose' && 'bg-white shadow-[0_2px_6px_rgb(0_0_0/0.12)]',
                ]}
              >
                {label}
              </span>
            ))
          }
        </div>
        <div class="mt-4 flex items-center justify-between rounded-[14px] bg-white px-4 py-3.5 text-[16px]">
          <span>Suggested</span>
          <span class="text-muted tabular-nums">1,850 kcal · 160 g</span>
        </div>
      </div>
    </FeatureCard>

    <FeatureCard
      title="Track as much as you like."
      body="Calories only, calories and macros, or fibre too. Each extra is just one more drag, and you can change your mind any time."
    >
      <div class="ios-scope w-full max-w-[300px] overflow-hidden rounded-[14px] bg-white">
        {
          toggles.map((t, i) => (
            <div class:list={['flex items-center justify-between py-2.5 pr-3 pl-4 text-[16px]', i > 0 && 'border-t-[0.5px] border-black/10']}>
              {t.label}
              <span class:list={['relative inline-block h-[26px] w-[42px] rounded-full', t.on ? 'bg-ios-green' : 'bg-[#e3e3e8]']}>
                <span
                  class:list={[
                    'absolute top-[2px] size-[22px] rounded-full bg-white shadow-[0_2px_4px_rgb(0_0_0/0.2)]',
                    t.on ? 'left-[18px]' : 'left-[2px]',
                  ]}
                />
              </span>
            </div>
          ))
        }
      </div>
    </FeatureCard>
  </div>
</section>
