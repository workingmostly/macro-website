---
const items = [
  'Barcode scanning',
  'Food databases',
  'Food photos',
  'Serving sizes',
  'Ingredient lists',
  'Accounts',
  'Ads',
];
---

<section class="py-14 sm:py-20" aria-labelledby="left-out">
  <p id="left-out" class="text-center text-[15px] font-semibold text-faint">Left out on purpose</p>
  <div
    class="mt-7 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]"
  >
    <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((item) => (
              <li class="flex items-center font-display text-[1.75rem] font-medium tracking-[-0.03em] text-ink/30 sm:text-4xl">
                <span class="strike">{item}</span>
                <span class="mx-8 inline-block w-1.5 sm:mx-12" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
