---
// Each principle is something the app actually does, so the section never promises an outcome.
const principles = [
  {
    title: 'About right is the aim.',
    body: "There's nothing to weigh, scan or look up. The drag is finest where most meals land, so a sensible guess takes seconds, and that's all Macro asks for.",
    tile: 'bg-green-tint text-ios-green',
    glyph: '≈',
  },
  {
    title: 'A bit over still counts.',
    body: "A day counts as on track when calories land within 10% of your goal, over or under, and protein gets close or goes over. On a 2,200 kcal goal, that's anywhere from 1,980 to 2,420.",
    tile: 'bg-blue-tint text-ios-blue',
    glyph: '±',
    range: true,
  },
  {
    title: 'Your week, not every bite.',
    body: 'The On track badge looks at Monday to Sunday as a whole and gives you a straight answer. Tap it to see why, and what would change it.',
    tile: 'bg-orange-tint',
    week: true,
  },
  {
    title: 'Log as little as you like.',
    body: 'Calories on their own are fine. Protein, carbs, fat and fibre are there if they help, and an emoji can stand in for a list of ingredients.',
    tile: 'bg-surface',
    glyph: '🍝',
  },
  {
    title: 'Nudges, not nagging.',
    body: "Reminders learn when you usually eat and stay quiet about meals you've already logged. There's no account and no ads, and what you log stays on your iPhone, and in your own iCloud if you sync.",
    tile: 'bg-surface',
    bell: true,
  },
];

// The On track band for the default goal, on a 1,700 to 2,700 kcal track.
const at = (v: number) => `${((v - 1700) / 1000) * 100}%`;
---

<section id="kinder" class="px-3 pt-28 sm:px-4 sm:pt-40" aria-labelledby="kinder-title">
  <div class="mx-auto grid max-w-6xl gap-12 px-3 lg:grid-cols-[1fr_1.35fr] lg:gap-20">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow text-ios-green">Ethos</p>
      <h2 id="kinder-title" class="display mt-5 text-[clamp(2.6rem,5.6vw,4.5rem)]">Keep count without it taking over.</h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-muted sm:text-xl">
        Counting every gram can turn food into homework, and it's easy for the numbers to take over. Macro asks for
        less: a rough number, logged in seconds, and a look at your week rather than every bite.
      </p>
      <p class="mt-8 text-[15px] text-muted">
        Found counting calories hard in the past?{' '}
        <a href="#faq-hard" class="text-ink underline decoration-ink/20 underline-offset-4 hover:decoration-ink">A note before you start</a>.
      </p>
    </div>

    <ul class="reveal divide-y divide-line border-y border-line">
      {
        principles.map((p) => (
          <li class="grid grid-cols-[2.75rem_1fr] gap-5 py-8 sm:grid-cols-[3.25rem_1fr] sm:gap-6 sm:py-10">
            <span
              aria-hidden="true"
              class={`grid size-11 place-items-center rounded-[14px] font-display text-2xl font-semibold sm:size-13 ${p.tile}`}
            >
              {p.glyph}
              {p.week && (
                <svg width="26" height="18" viewBox="0 0 26 18">
                  {[11, 9, 14, 10, 12, 8, 0].map((h, i) => (
                    <rect x={i * 4} y={18 - h} width="3" height={h} rx="1" fill={h > 13 ? '#f2a144' : '#34c759'} />
                  ))}
                </svg>
              )}
              {p.bell && (
                <svg width="20" height="22" viewBox="0 0 20 22" fill="none">
                  <path
                    d="M10 2.5a5.5 5.5 0 0 0-5.5 5.5v3.6L3 14.8h14l-1.5-3.2V8A5.5 5.5 0 0 0 10 2.5zM7.8 17.5a2.3 2.3 0 0 0 4.4 0"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-ink/70"
                  />
                </svg>
              )}
            </span>
            <div>
              <h3 class="font-display text-2xl font-semibold tracking-[-0.03em] sm:text-[1.75rem]">{p.title}</h3>
              <p class="mt-2 max-w-xl text-[17px] leading-relaxed text-muted">{p.body}</p>
              {p.range && (
                <div class="mt-5 max-w-sm" role="img" aria-label="On a 2,200 kcal goal, anything from 1,980 to 2,420 counts">
                  <div class="relative h-3 rounded-full bg-surface">
                    <div
                      class="absolute inset-y-0 rounded-full bg-ios-green/35 ring-2 ring-ios-green/70 ring-inset"
                      style={`left:${at(1980)};right:calc(100% - ${at(2420)})`}
                    />
                    <div class="absolute -inset-y-1.5 border-l-2 border-dashed border-[#5aa9ff]" style={`left:${at(2200)}`} />
                  </div>
                  <div aria-hidden="true" class="relative mt-2 h-5 text-[13px] text-muted tabular-nums">
                    <span class="absolute -translate-x-1/2" style={`left:${at(1980)}`}>1,980</span>
                    <span class="absolute -translate-x-1/2 text-ios-blue-dark" style={`left:${at(2200)}`}>2,200</span>
                    <span class="absolute -translate-x-1/2" style={`left:${at(2420)}`}>2,420</span>
                  </div>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
