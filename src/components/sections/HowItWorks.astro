---
import HowItWorksDemo from '../HowItWorksDemo';
---

<section id="how-it-works" class="px-3 pt-28 sm:px-4 sm:pt-40">
  <div class="reveal mx-auto max-w-3xl px-3 text-center">
    <p class="eyebrow text-ios-green">How it works</p>
    <h2 class="display mt-5 text-[clamp(2.6rem,6.4vw,4.75rem)]">Log a meal in seconds.</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">
      Macro opens straight onto a new meal, so there's nothing to tap through first. Then it's two drags and you're done.
    </p>
  </div>

  <!-- Hydrates a little before it scrolls into view, so it can rewind to the first drag without a visible jump. -->
  <HowItWorksDemo client:visible={{ rootMargin: '400px' }} />
</section>
