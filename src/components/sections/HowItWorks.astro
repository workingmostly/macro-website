---
import { InputScreen, Phone, TodayScreen, SAMPLE_DAY } from '../screens/ios';

const steps = [
  {
    title: 'Drag your calories',
    body: 'Drag anywhere on the screen: up for more, down for less. The colour warms from green towards red as the meal gets bigger.',
    tint: 'bg-green-tint',
    glow: 'rgb(52 199 89 / 0.28)',
  },
  {
    title: 'Drag your protein',
    body: "Tap to confirm, then do the same for protein. The slider is finest where most meals land, so it's easy to be about right.",
    tint: 'bg-blue-tint',
    glow: 'rgb(0 122 255 / 0.22)',
  },
  {
    title: "That's it",
    body: 'Carbs and fat are estimated from whatever calories are left. Tag it with a food emoji if you like, and your day adds itself up.',
    tint: 'bg-surface',
    glow: 'rgb(0 0 0 / 0.06)',
  },
];
---

<section id="how-it-works" class="px-3 pt-28 sm:px-4 sm:pt-40">
  <div class="reveal mx-auto max-w-3xl px-3 text-center">
    <p class="eyebrow text-ios-green">How it works</p>
    <h2 class="display mt-5 text-[clamp(2.6rem,6.4vw,4.75rem)]">Log a meal in seconds.</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">
      Macro opens straight onto a new meal, so there's nothing to tap through first. Then it's two drags and you're done.
    </p>
  </div>

  <div class="mt-14 grid gap-3 sm:mt-20 sm:gap-4 md:grid-cols-3">
    {
      steps.map((step, i) => (
        <article class="reveal overflow-hidden rounded-card bg-surface" style={`transition-delay:${i * 90}ms`}>
          <div class={`relative flex h-[400px] justify-center overflow-hidden pt-10 sm:h-[460px] ${step.tint}`}>
            <div
              aria-hidden="true"
              class="absolute inset-0"
              style={`background:radial-gradient(70% 60% at 50% 60%, ${step.glow}, transparent)`}
            />
            <Phone className="relative [--s:0.58] md:[--s:0.5] lg:[--s:0.6]">
              {i === 0 && <InputScreen field="calories" value={520} stepIndex={0} />}
              {i === 1 && <InputScreen field="protein" value={38} stepIndex={1} />}
              {i === 2 && <TodayScreen meals={SAMPLE_DAY} />}
            </Phone>
          </div>
          <div class="p-8 sm:p-10">
            <h3 class="font-display text-2xl font-semibold tracking-[-0.03em] sm:text-[1.75rem]">
              <span class="text-ink/30">{i + 1}.</span> {step.title}
            </h3>
            <p class="mt-3 text-[17px] leading-relaxed text-muted">{step.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
