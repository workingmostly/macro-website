---
import { site } from '../../config';

const links = [
  { href: '/#why', label: 'Why it works' },
  { href: '/#kinder', label: 'Balance' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#features', label: 'Features' },
  { href: '/#faq', label: 'FAQ' },
];
---

<!-- On mobile it sits above the hero card. From sm up it sits inset inside the card on landing, then tucks up to the top once scrolling starts. -->
<header
  data-nav
  class="fixed inset-x-0 top-3 z-50 px-3 transition-transform duration-300 ease-out sm:top-4 sm:translate-y-4 sm:px-4 sm:data-scrolled:translate-y-0"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between rounded-l-[24px] rounded-r-[32px] bg-white/80 pr-2 pl-3.5 shadow-[0_8px_30px_rgb(0_0_0/0.07)] ring-1 ring-black/[0.06] backdrop-blur-xl backdrop-saturate-150"
    aria-label="Main"
  >
    <a href="/" data-home class="flex items-center gap-2.5 rounded-full pr-2" aria-label="Macro home">
      <img src="/icon.png" alt="" width="36" height="36" class="size-9 rounded-[10px]" />
      <span class="font-display text-[22px] font-semibold tracking-[-0.035em]">Macro</span>
    </a>

    <div class="hidden items-center gap-6 text-[15px] text-ink/70 md:flex lg:gap-9">
      {
        links.map((link) => (
          <a href={link.href} class="transition-colors hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </div>

    <a href={site.betaUrl} target="_blank" rel="noopener" class="btn btn-primary h-12 px-6 text-[15px]">{site.ctaLabel}</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 16);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // On the home page the logo scrolls back to the top rather than reloading, like the section links. Elsewhere it's
  // an ordinary link home, and a modified click (new tab and so on) is left alone.
  document.querySelector('[data-home]')?.addEventListener('click', (event) => {
    const e = event as MouseEvent;
    if (location.pathname !== '/' || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    if (location.hash) history.replaceState(null, '', '/');
    window.scrollTo({ top: 0 });
  });
</script>
