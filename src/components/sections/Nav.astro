---
import { site } from '../../config';

const links = [
  { href: '/#why', label: 'Why it works' },
  { href: '/#kinder', label: 'Balance' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#features', label: 'Features' },
  { href: '/#faq', label: 'FAQ' },
];
---

<!-- On mobile it sits above the hero card. From sm up it sits inset inside the card, and from lg up (where the hero
     text is left-aligned) the logo lines up with the headline. At the top it lies flat on the page, with no bar behind
     it; as you scroll it lifts off into a floating bar (see .nav in global.css). Its button only shows while no other
     "Join the beta" button is on screen. Until then the links sit on the right; when it slides in from the right they
     move to the centre. The logo and the button each sit in a group that takes an equal share of the spare space,
     which is what centres the links between them. -->
<header data-nav class="nav fixed inset-x-0 top-3 z-50 px-3 sm:top-4 sm:px-4">
  <div class="mx-auto max-w-6xl lg:px-[26px]">
    <!-- Even padding either side, so the links centre on the bar; the logo's margin takes it to 14px in -->
    <nav class="nav-bar flex h-16 items-center px-2" aria-label="Main">
      <div class="nav-start flex">
        <a href="/" data-home class="ml-1.5 flex items-center gap-2.5 rounded-full pr-2" aria-label="Macro home">
          <img src="/icon.png" alt="" width="36" height="36" class="size-9 rounded-[10px]" />
          <span class="font-display text-[22px] font-semibold tracking-[-0.035em]">Macro</span>
        </a>
      </div>

      <div class="nav-links hidden shrink-0 items-center gap-5 text-[15px] whitespace-nowrap text-ink/70 md:flex lg:gap-9">
        {
          links.map((link) => (
            <a href={link.href} class="transition-colors hover:text-ink">
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="nav-end flex justify-end">
        <!-- ml-5 matches the links' gap at md, the least room the button gets when the bar is too tight to centre them -->
        <div class="nav-cta-slot">
          <a href={site.betaUrl} target="_blank" rel="noopener" class="nav-cta btn btn-primary ml-5 h-12 px-6 text-[15px]">
            {site.ctaLabel}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  if (header) {
    // --lift eases from 0 to 1 over the first LIFT_PX of scroll. Only written when it changes, so scrolling further
    // down the page doesn't restyle the nav.
    const LIFT_PX = 64;
    let lift = -1;
    const update = () => {
      const t = Math.min(Math.max(window.scrollY / LIFT_PX, 0), 1);
      const next = Math.round((1 - (1 - t) ** 2) * 100) / 100;
      if (next !== lift) header.style.setProperty('--lift', String((lift = next)));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });

    // Every other "Join the beta" button on the page is marked data-cta. The nav's own one shows only while none of
    // them is on screen, so there's never more than one asking at a time. One that's slid up under the nav counts as
    // gone. On pages without one (the privacy policy) the CSS never hides it, so there's nothing to watch.
    const onScreen = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        header.toggleAttribute('data-show-cta', onScreen.size === 0);

        // The first call just sets where the page starts (say, opened partway down, or on a screen too short to show
        // the hero's button), so that lands instantly. Reading offsetWidth applies it before data-ready switches the
        // transitions on; only changes after that slide.
        if (!header.hasAttribute('data-ready')) {
          void header.offsetWidth;
          header.toggleAttribute('data-ready', true);
        }
      },
      // -80px is the lifted bar's bottom edge: 16px from the top, 64px tall
      { rootMargin: '-80px 0px 0px 0px' },
    );
    document.querySelectorAll('[data-cta]').forEach((el) => io.observe(el));
  }

  // On the home page the logo scrolls back to the top rather than reloading, like the section links. Elsewhere it's
  // an ordinary link home, and a modified click (new tab and so on) is left alone.
  document.querySelector('[data-home]')?.addEventListener('click', (event) => {
    const e = event as MouseEvent;
    if (location.pathname !== '/' || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    if (location.hash) history.replaceState(null, '', '/');
    window.scrollTo({ top: 0 });
  });
</script>
